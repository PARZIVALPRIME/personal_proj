+/* The resident set NOW, in the unit of rss_gb (GiB). rss_gb() is the PEAK (ru_maxrss;
+ * compat.h's Windows shim reads PeakWorkingSetSize), which still counts the float32
+ * copies the load quantized and freed: against a RAM_GB budget that peak took room
+ * from the expert cache that the process no longer holds. Falls back to the peak. */
+static double rss_now_gb(void) {
+#if defined(_WIN32)
+    PROCESS_MEMORY_COUNTERS pmc;
+    memset(&pmc, 0, sizeof pmc); pmc.cb = sizeof pmc;
+    if (GetProcessMemoryInfo(GetCurrentProcess(), &pmc, sizeof pmc) && pmc.WorkingSetSize)
+        return (double)pmc.WorkingSetSize / 1073741824.0;
+#elif defined(__linux__)
+    FILE *f = fopen("/proc/self/statm", "r");
+    if (f) {
+        long size = 0, res = 0; int ok = fscanf(f, "%ld %ld", &size, &res) == 2; fclose(f);
+        long pg = sysconf(_SC_PAGESIZE);
+        if (ok && res > 0 && pg > 0) return (double)res * (double)pg / 1073741824.0;
+    }
+#endif
+    return rss_gb();
