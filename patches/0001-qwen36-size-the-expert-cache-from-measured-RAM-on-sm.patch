+/* The KV cache a context of max_ctx positions will hold on layers [lb, le), in GiB.
+ * ensure_kv grows it lazily, so none of it is resident when the expert cache is sized
+ * after loading: without this reserve a long chat on a 16 GB host grew its KV into the
+ * RAM the slots had already taken (0.65 GiB float16 at 32k on the 35B). Pure. */
+static double q36_kv_reserve_gb(const Cfg *c, int lb, int le, int max_ctx, size_t es) {
+    if (!c || max_ctx < 1 || !c->is_attn) return 0.0;
+    int ring = q36_ring_for(c, max_ctx);
+    double bytes = 0.0;
+    for (int i = lb < 0 ? 0 : lb; i < le && i < c->n_layers; i++) {
+        if (!c->is_attn[i]) continue;
+        int rows = ring && c->win_layer && c->win_layer[i] ? ring : max_ctx;
+        bytes += 2.0 * c->kv_heads * (double)rows * c->k_head_dim * (double)es;
+    }
+    return bytes / 1073741824.0;
+}
