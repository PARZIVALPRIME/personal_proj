new file mode 100644
index 00000000..3352a8bf
--- /dev/null
+++ b/agent/coliagent/selfimprove.py
@@ -0,0 +1,176 @@
+"""A controlled self-improvement cycle.
+
+One cycle tests one hypothesis with one patch:
+
+  1. refuse the patch if it touches a protected path (the policy, this module,
+     .git, CI) - the agent cannot loosen its own rules or its own gate;
+  2. create an isolated git worktree on a fresh branch agent/improve-<id>;
+  3. measure the baseline metric there (if the hypothesis has a metric);
+  4. apply the patch, run every gate command, measure the metric again;
+  5. accept only if every gate passes and the metric moved by at least
+     ``min_gain`` in the right direction (median of ``repeats`` samples);
+  6. on acceptance commit to the branch (locally) and keep the branch for a
+     person to review; on rejection delete the branch. The worktree is always
+     removed, and every outcome is appended to a JSONL ledger.
+
+It never merges, never touches the main checkout, and never pushes.
+"""
+from __future__ import annotations
+
+import dataclasses
+import json
+import re
+import shutil
+import tempfile
+import time
+import uuid
+from dataclasses import dataclass, field
+from pathlib import Path
+from statistics import median
+from typing import Dict, List, Optional
+
+from . import patch as patchmod
+from .permissions import PermissionDenied, Policy
+from .repo import RepoManager
+from .state import gain_of
+from .tools import CommandResult, ToolRunner
+
+
+@dataclass
+class Hypothesis:
+    statement: str
+    metric: Optional[str] = None            # e.g. "decode tok/s"
+    metric_argv: Optional[List[str]] = None  # command that prints the metric
+    metric_regex: str = r"([-+]?\d+(?:\.\d+)?)"
+    metric_cwd: str = "."
+    lower_is_better: bool = False
+    min_gain: float = 0.02
+    repeats: int = 3
+
+
+@dataclass
+class Gate:
+    argv: List[str]
+    cwd: str = "."
+    timeout: Optional[float] = None
+
+
+@dataclass
+class Outcome:
+    id: str
+    accepted: bool
+    reason: str
+    branch: Optional[str] = None
+    commit: Optional[str] = None
+    baseline: List[float] = field(default_factory=list)
+    candidate: List[float] = field(default_factory=list)
+    gain: Optional[float] = None
+    gates: List[str] = field(default_factory=list)
+    diff: str = ""
+
+
+class ImprovementCycle:
+    def __init__(self, repo: RepoManager, policy: Policy, gates: List[Gate], ledger: Optional[str] = None,
+                 workdir: Optional[str] = None):
+        self.repo = repo
+        self.policy = policy
+        self.gates = gates
+        self.workdir = workdir or tempfile.gettempdir()
+        if ledger is None:
+            common = repo.git("rev-parse", "--git-common-dir").stdout.strip()
+            common_path = Path(common) if Path(common).is_absolute() else Path(repo.root) / common
+            ledger = str(common_path / "coliagent" / "ledger.jsonl")
+        self.ledger = ledger
+
+    def _metric(self, runner: ToolRunner, root: Path, h: Hypothesis) -> tuple:
+        samples: List[float] = []
+        results: List[CommandResult] = []
+        rx = re.compile(h.metric_regex)
+        for _ in range(max(1, h.repeats)):
+            res = runner.run(h.metric_argv, cwd=str(root / h.metric_cwd))
+            results.append(res)
+            if not res.ok:
+                return samples, results, f"metric command failed: {res.summary()}"
+            m = rx.search(res.stdout + "\n" + res.stderr)
+            if not m:
+                return samples, results, f"metric regex {h.metric_regex!r} found nothing"
+            samples.append(float(m.group(1)))
+        return samples, results, ""
+
+    def _record(self, out: Outcome, h: Hypothesis) -> None:
+        p = Path(self.ledger)
+        p.parent.mkdir(parents=True, exist_ok=True)
+        rec = dataclasses.asdict(out)
+        rec["hypothesis"] = dataclasses.asdict(h)
+        rec["at"] = time.strftime("%Y-%m-%dT%H:%M:%S")
+        rec["diff_lines"] = out.diff.count("\n")
+        rec.pop("diff")
+        with open(p, "a", encoding="utf-8") as fh:
+            fh.write(json.dumps(rec) + "\n")
+
+    def run(self, h: Hypothesis, candidate: patchmod.Patch, cid: Optional[str] = None) -> Outcome:
+        cid = cid or uuid.uuid4().hex[:8]
+        branch = f"agent/improve-{cid}"
+        if self.policy.touches_protected(candidate.paths):
+            out = Outcome(cid, False, "patch touches a protected path")
+            self._record(out, h)
+            return out
+        if h.metric_argv is None and h.metric:
+            raise ValueError("a metric needs metric_argv")
+        wt = Path(self.workdir) / f"coliagent-{cid}"
+        if wt.exists():
+            shutil.rmtree(wt, ignore_errors=True)
+        out = Outcome(cid, False, "", branch=branch)
+        created = False
+        try:
+            self.repo.worktree_add(str(wt), branch)
+            created = True
+            wt_policy = dataclasses.replace(self.policy, root=str(wt.resolve()))
+            # no .pyc: a patch that keeps a file's size within the same mtime
+            # second would otherwise be masked by the baseline run's bytecode
+            runner = ToolRunner(wt_policy, base_env={"PYTHONDONTWRITEBYTECODE": "1"})
+            if h.metric_argv:
+                out.baseline, _, err = self._metric(runner, wt, h)
+                if err:
+                    out.reason = "baseline " + err
+                    return out
+            try:
+                out.diff = patchmod.apply(candidate, str(wt), wt_policy)
+            except (patchmod.PatchError, PermissionDenied) as e:
+                out.reason = f"patch rejected: {e}"
+                return out
+            for g in self.gates:
+                res = runner.run(g.argv, cwd=str(wt / g.cwd), timeout=g.timeout)
+                out.gates.append(res.summary())
+                if not res.ok:
+                    out.reason = f"gate failed: {res.summary()}\n{(res.stdout + res.stderr)[-2000:]}"
+                    return out
+            if h.metric_argv:
+                out.candidate, _, err = self._metric(runner, wt, h)
+                if err:
+                    out.reason = "candidate " + err
+                    return out
+                out.gain = gain_of(median(out.baseline), median(out.candidate), h.lower_is_better)
+                if out.gain < h.min_gain:
+                    out.reason = f"{h.metric}: gain {out.gain:.2%} below the required {h.min_gain:.2%}"
+                    return out
+            wt_repo = RepoManager(runner, str(wt))
+            msg = f"agent: {h.statement}\n\n{candidate.description}".rstrip()
+            if out.gain is not None:
+                msg += f"\n\n{h.metric}: median {median(out.baseline):g} -> {median(out.candidate):g} ({out.gain:+.2%})"
+            out.commit = wt_repo.commit(msg, paths=candidate.paths)
+            out.accepted = True
+            out.reason = "all gates passed" + ("" if out.gain is None else f"; gain {out.gain:+.2%}")
+            return out
+        finally:
+            if created:
+                self.repo.worktree_remove(str(wt), None if out.accepted else branch)
+            if not out.accepted:
+                out.branch = None
+            self._record(out, h)
+
+    def history(self) -> List[Dict]:
+        p = Path(self.ledger)
+        if not p.is_file():
+            return []
+        return [json.loads(l) for l in p.read_text(encoding="utf-8").splitlines() if l.strip()]
diff --git a/agent/coliagent/state.py b/agent/coliagent/state.py
new file mode 100644
index 00000000..97b9cf48
--- /dev/null
+++ b/agent/coliagent/state.py
@@ -0,0 +1,122 @@
+"""Explicit project state and evidence-backed claims.
+
+A claim moves up a ladder; every rung above "proposed" needs evidence of the
+matching kind, so "it is faster" cannot be recorded without a measurement and
+"the tests pass" cannot be recorded without a passing run:
+
+  proposed       an idea or hypothesis; no evidence needed
+  applied        a change exists        evidence: a non-empty diff
+  built          it compiles            evidence: a successful build command
+  tested         tests pass             evidence: successful test commands
+  perf-verified  a metric improved      evidence: baseline and candidate samples
+                                        on the same machine, plus the command
+"""
+from __future__ import annotations
+
+import json
+import time
+from dataclasses import asdict, dataclass, field
+from pathlib import Path
+from statistics import median
+from typing import Dict, List, Optional
+
+from .tools import CommandResult
+
+LEVELS = ("proposed", "applied", "built", "tested", "perf-verified")
+
+
+class EvidenceError(Exception):
+    pass
+
+
+@dataclass
+class Claim:
+    id: str
+    statement: str
+    level: str = "proposed"
+    evidence: List[Dict] = field(default_factory=list)
+    updated: float = field(default_factory=time.time)
+
+
+def _cmd_evidence(results: List[CommandResult], kind: str) -> Dict:
+    if not results:
+        raise EvidenceError(f"{kind} needs at least one command result")
+    bad = [r.summary() for r in results if not r.ok]
+    if bad:
+        raise EvidenceError(f"{kind} evidence includes failures: {bad}")
+    return {"kind": kind, "commands": [r.summary() for r in results], "at": time.time()}
+
+
+@dataclass
+class ProjectState:
+    path: str
+    claims: Dict[str, Claim] = field(default_factory=dict)
+    notes: List[str] = field(default_factory=list)
+
+    @classmethod
+    def load(cls, path: str) -> "ProjectState":
+        p = Path(path)
+        st = cls(str(p))
+        if p.is_file():
+            data = json.loads(p.read_text(encoding="utf-8"))
+            st.claims = {k: Claim(**v) for k, v in data.get("claims", {}).items()}
+            st.notes = list(data.get("notes", []))
+        return st
+
+    def save(self) -> None:
+        p = Path(self.path)
+        p.parent.mkdir(parents=True, exist_ok=True)
+        tmp = p.with_suffix(p.suffix + ".tmp")
+        tmp.write_text(json.dumps({"claims": {k: asdict(v) for k, v in self.claims.items()},
+                                   "notes": self.notes}, indent=2), encoding="utf-8")
+        tmp.replace(p)
+
+    def propose(self, cid: str, statement: str) -> Claim:
+        c = self.claims.get(cid) or Claim(cid, statement)
+        self.claims[cid] = c
+        return c
+
+    def _raise(self, cid: str, level: str, ev: Dict) -> Claim:
+        c = self.claims[cid]
+        if LEVELS.index(level) > LEVELS.index(c.level):
+            c.level = level
+        c.evidence.append(ev)
+        c.updated = time.time()
+        return c
+
+    def applied(self, cid: str, diff: str) -> Claim:
+        if not diff.strip():
+            raise EvidenceError("applied needs a non-empty diff")
+        return self._raise(cid, "applied", {"kind": "diff", "lines": diff.count("\n"), "at": time.time()})
+
+    def built(self, cid: str, results: List[CommandResult]) -> Claim:
+        return self._raise(cid, "built", _cmd_evidence(results, "build"))
+
+    def tested(self, cid: str, results: List[CommandResult]) -> Claim:
+        return self._raise(cid, "tested", _cmd_evidence(results, "test"))
+
+    def perf_verified(self, cid: str, metric: str, baseline: List[float], candidate: List[float],
+                      lower_is_better: bool, min_gain: float, results: List[CommandResult],
+                      machine: str = "") -> Claim:
+        if len(baseline) < 1 or len(candidate) < 1:
+            raise EvidenceError("perf-verified needs baseline and candidate samples")
+        _cmd_evidence(results, "benchmark")
+        b, c = median(baseline), median(candidate)
+        gain = gain_of(b, c, lower_is_better)
+        if gain < min_gain:
+            raise EvidenceError(f"{metric}: gain {gain:.3%} is below the required {min_gain:.3%}")
+        return self._raise(cid, "perf-verified", {"kind": "metric", "metric": metric, "baseline": baseline,
+                                                  "candidate": candidate, "gain": gain, "machine": machine,
+                                                  "commands": [r.summary() for r in results], "at": time.time()})
+
+    def report(self) -> str:
+        lines = []
+        for c in sorted(self.claims.values(), key=lambda c: (-LEVELS.index(c.level), c.id)):
+            lines.append(f"[{c.level:>13}] {c.id}: {c.statement}")
+        return "\n".join(lines) or "(no claims)"
+
+
+def gain_of(baseline: float, candidate: float, lower_is_better: bool) -> float:
+    if baseline == 0:
+        return 0.0
+    return (baseline - candidate) / baseline if lower_is_better else (candidate - baseline) / baseline
