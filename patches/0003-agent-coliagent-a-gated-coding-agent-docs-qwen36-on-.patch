+"""Repository index: inventory, symbols, text search, include/import graph.
+
+Regex based on purpose: it is fast, dependency free, and good enough to point
+the agent (or a person) at the right file. It is not a compiler front end.
+"""
+from __future__ import annotations
+
+import os
+import re
+from collections import defaultdict
+from dataclasses import dataclass
+from pathlib import Path
+from typing import Dict, Iterable, List, Optional, Set
+
+SKIP_DIRS = {".git", "__pycache__", "node_modules", "build", "dist", ".venv", "venv", ".mypy_cache", ".pytest_cache"}
+TEXT_EXT = {".py", ".c", ".h", ".cc", ".cpp", ".hpp", ".cu", ".js", ".ts", ".tsx", ".go", ".rs", ".md",
+            ".txt", ".toml", ".json", ".yml", ".yaml", ".ps1", ".sh", ".cmake", ""}
+MAX_BYTES = 4 * 1024 * 1024
+
+_SYM = {
+    ".py": [(re.compile(r"^\s*def\s+([A-Za-z_]\w*)\s*\(", re.M), "function"),
+            (re.compile(r"^\s*class\s+([A-Za-z_]\w*)", re.M), "class")],
+    ".c": [(re.compile(r"^(?!\s)(?:static\s+|inline\s+|extern\s+)*[A-Za-z_][\w\s\*]*?\b([A-Za-z_]\w*)\s*\([^;{]*\)\s*\{", re.M), "function"),
+           (re.compile(r"^\s*#\s*define\s+([A-Za-z_]\w*)", re.M), "macro"),
+           (re.compile(r"^\s*typedef\s+struct\s*\w*\s*\{[^}]*\}\s*([A-Za-z_]\w*)\s*;", re.M | re.S), "type")],
+    ".js": [(re.compile(r"^\s*(?:export\s+)?(?:async\s+)?function\s+([A-Za-z_$][\w$]*)", re.M), "function"),
+            (re.compile(r"^\s*(?:export\s+)?class\s+([A-Za-z_$][\w$]*)", re.M), "class")],
+}
+_SYM[".h"] = _SYM[".c"] + [(re.compile(r"^[A-Za-z_][\w\s\*]*?\b([A-Za-z_]\w*)\s*\([^;{]*\)\s*;", re.M), "prototype")]
+_SYM[".cu"] = _SYM[".cc"] = _SYM[".cpp"] = _SYM[".c"]
+_SYM[".ts"] = _SYM[".tsx"] = _SYM[".js"]
+_C_KEYWORDS = {"if", "for", "while", "switch", "return", "sizeof", "else", "do"}
+
+_PY_IMPORT = re.compile(r"^\s*(?:from\s+([\w.]+)\s+import\s+(\([^)]*\)|[^\n#]+)|import\s+([\w.]+))", re.M)
+_C_INCLUDE = re.compile(r'^\s*#\s*include\s+"([^"]+)"', re.M)
+
+
+@dataclass(frozen=True)
+class Symbol:
+    name: str
+    kind: str
+    path: str
+    line: int
+
+
+@dataclass(frozen=True)
+class Hit:
+    path: str
+    line: int
+    text: str
+
+
+class RepoIndex:
+    def __init__(self, root: str, files: Optional[Iterable[str]] = None):
+        self.root = Path(root).resolve()
+        self.files: List[str] = sorted(files) if files is not None else self._walk()
+        self._text: Dict[str, str] = {}
+
+    def _walk(self) -> List[str]:
+        out = []
+        for d, dirs, names in os.walk(self.root):
+            dirs[:] = [x for x in dirs if x not in SKIP_DIRS]
+            for n in names:
+                out.append((Path(d) / n).relative_to(self.root).as_posix())
+        return sorted(out)
+
+    def text(self, rel: str) -> str:
+        if rel not in self._text:
+            p = self.root / rel
+            if Path(rel).suffix.lower() not in TEXT_EXT or not p.is_file() or p.stat().st_size > MAX_BYTES:
+                self._text[rel] = ""
+            else:
+                try:
+                    self._text[rel] = p.read_text(encoding="utf-8", errors="replace")
+                except OSError:
+                    self._text[rel] = ""
+        return self._text[rel]
+
+    def symbols(self, rel: Optional[str] = None) -> List[Symbol]:
+        out: List[Symbol] = []
+        for f in [rel] if rel else self.files:
+            pats = _SYM.get(Path(f).suffix.lower())
+            if not pats:
+                continue
+            src = self.text(f)
+            for rx, kind in pats:
+                for m in rx.finditer(src):
+                    name = m.group(1)
+                    if name in _C_KEYWORDS:
+                        continue
+                    out.append(Symbol(name, kind, f, src.count("\n", 0, m.start(1)) + 1))
+        return sorted(out, key=lambda s: (s.path, s.line))
+
+    def find_symbol(self, name: str) -> List[Symbol]:
+        return [s for s in self.symbols() if s.name == name]
+
+    def search(self, pattern: str, regex: bool = False, glob: Optional[str] = None, limit: int = 200) -> List[Hit]:
+        rx = re.compile(pattern if regex else re.escape(pattern))
+        hits: List[Hit] = []
+        for f in self.files:
+            if glob and not Path(f).match(glob):
+                continue
+            for i, line in enumerate(self.text(f).splitlines(), 1):
+                if rx.search(line):
+                    hits.append(Hit(f, i, line.strip()[:240]))
+                    if len(hits) >= limit:
+                        return hits
+        return hits
+
+    def dependency_graph(self) -> Dict[str, Set[str]]:
+        """file -> files in the repository it imports or includes."""
+        by_module: Dict[str, str] = {}
+        by_name: Dict[str, List[str]] = defaultdict(list)
+        for f in self.files:
+            p = Path(f)
+            if p.suffix == ".py":
+                parts = list(p.with_suffix("").parts)
+                if parts[-1] == "__init__":
+                    parts = parts[:-1]
+                for i in range(len(parts)):
+                    by_module.setdefault(".".join(parts[i:]), f)
+            by_name[p.name].append(f)
+        graph: Dict[str, Set[str]] = {}
+        for f in self.files:
+            suf = Path(f).suffix.lower()
+            deps: Set[str] = set()
+            src = self.text(f)
+            if suf == ".py":
+                for m in _PY_IMPORT.finditer(src):
+                    if m.group(1):
+                        names = [part.split()[0] for part in m.group(2).strip("() \t").replace("\n", " ").split(",")
+                                 if part.split()]
+                        mods = [f"{m.group(1)}.{n}" for n in names] + [m.group(1)]
+                    else:
+                        mods = [m.group(3)]
+                    for k, mod in enumerate(mods):
+                        # "from pkg import sub" names a submodule when one exists
+                        exact = by_module.get(mod)
+                        if exact:
+                            deps.add(exact)
+                            continue
+                        if k != len(mods) - 1:
+                            continue
+                        while mod:
+                            if mod in by_module:
+                                deps.add(by_module[mod])
+                                break
+                            mod = mod.rpartition(".")[0]
+            elif suf in (".c", ".h", ".cc", ".cpp", ".cu", ".hpp"):
+                here = Path(f).parent
+                for m in _C_INCLUDE.finditer(src):
+                    inc = m.group(1)
+                    cand = os.path.normpath(here / inc).replace("\\", "/")
+                    if cand in self.files:
+                        deps.add(cand)
+                    elif len(by_name.get(Path(inc).name, [])) == 1:
+                        deps.add(by_name[Path(inc).name][0])
+            deps.discard(f)
+            graph[f] = deps
+        return graph
+
+    def dependents(self, changed: Iterable[str]) -> Set[str]:
+        """Every file that transitively imports or includes one of ``changed``."""
+        rev: Dict[str, Set[str]] = defaultdict(set)
+        for f, deps in self.dependency_graph().items():
+            for d in deps:
+                rev[d].add(f)
+        seen: Set[str] = set()
+        stack = list(changed)
+        while stack:
+            cur = stack.pop()
+            for nxt in rev.get(cur, ()):
+                if nxt not in seen:
+                    seen.add(nxt)
+                    stack.append(nxt)
+        return seen
diff --git a/agent/coliagent/llm.py b/agent/coliagent/llm.py
new file mode 100644
index 00000000..c0bd868d
--- /dev/null
+++ b/agent/coliagent/llm.py
@@ -0,0 +1,59 @@
+"""Model backends.
+
+``OpenAICompatible`` talks to any /v1/chat/completions server; the default URL
+is a local Colibri gateway (``coli serve``), so the agent can run entirely on
+the machine it is improving. ``ScriptedBackend`` replays canned replies for
+tests and dry runs.
+"""
+from __future__ import annotations
+
+import json
+import os
+import urllib.error
+import urllib.request
+from typing import Dict, Iterable, List, Optional
+
+
+class LLMError(Exception):
+    pass
+
+
+class OpenAICompatible:
+    def __init__(self, base_url: Optional[str] = None, model: Optional[str] = None,
+                 api_key: Optional[str] = None, timeout: float = 600.0,
+                 temperature: float = 0.2, max_tokens: int = 2048):
+        self.base_url = (base_url or os.environ.get("COLIAGENT_BASE_URL") or "http://127.0.0.1:8000/v1").rstrip("/")
+        self.model = model or os.environ.get("COLIAGENT_MODEL") or "colibri"
+        self.api_key = api_key if api_key is not None else os.environ.get("COLIAGENT_API_KEY", "")
+        self.timeout = timeout
+        self.temperature = temperature
+        self.max_tokens = max_tokens
+
+    def complete(self, messages: List[Dict[str, str]], **kw) -> str:
+        body = {"model": self.model, "messages": messages, "temperature": kw.get("temperature", self.temperature),
+                "max_tokens": kw.get("max_tokens", self.max_tokens), "stream": False}
+        req = urllib.request.Request(self.base_url + "/chat/completions", data=json.dumps(body).encode(),
+                                     headers={"Content-Type": "application/json"}, method="POST")
+        if self.api_key:
+            req.add_header("Authorization", "Bearer " + self.api_key)
+        try:
+            with urllib.request.urlopen(req, timeout=self.timeout) as r:
+                data = json.loads(r.read().decode("utf-8"))
+        except (urllib.error.URLError, OSError, ValueError) as e:
+            raise LLMError(f"{self.base_url}: {e}") from e
+        try:
+            return data["choices"][0]["message"]["content"] or ""
+        except (KeyError, IndexError, TypeError) as e:
+            raise LLMError(f"unexpected reply shape: {str(data)[:200]}") from e
+
+
+class ScriptedBackend:
+    def __init__(self, replies: Iterable[str]):
+        self.replies = list(replies)
+        self.calls: List[List[Dict[str, str]]] = []
+
+    def complete(self, messages: List[Dict[str, str]], **kw) -> str:
+        self.calls.append(messages)
+        if not self.replies:
+            raise LLMError("scripted backend has no replies left")
+        return self.replies.pop(0)
diff --git a/agent/coliagent/orchestrate.py b/agent/coliagent/orchestrate.py
new file mode 100644
index 00000000..00790c6e
--- /dev/null
+++ b/agent/coliagent/orchestrate.py
@@ -0,0 +1,133 @@
+"""Build and test orchestration, with test selection from changed files.
+
+Project knowledge lives in a small JSON config rather than in code:
+
+    {
+      "build": [{"cwd": "c", "argv": ["make", "qwen36"]}],
+      "tests": [
+        {"pattern": "c/tests/test_*.py", "cwd": "c",
+         "steps": [["python", "-m", "unittest", "tests.{stem}"]]},
+        {"pattern": "c/tests/test_*.c", "cwd": "c",
+         "steps": [["make", "tests/{stem}"], ["./tests/{stem}"]]}
+      ],
+      "full": [{"cwd": ".", "argv": ["python", "-m", "unittest", "discover"]}],
+      "always": ["c/tests/test_openai_server.py"]
+    }
+
+A test is selected when it changed, when it imports/includes a changed file
+(transitively), or when its name mentions a changed file's stem.
+"""
+from __future__ import annotations
+
+import fnmatch
+import json
+import re
+from dataclasses import dataclass, field
+from pathlib import Path, PurePosixPath
+from typing import Dict, Iterable, List, Optional
+
+from .index import RepoIndex
+from .tools import CommandResult, ToolRunner
+
+DEFAULT_CONFIG: Dict = {
+    "build": [],
+    "tests": [{"pattern": "tests/test_*.py", "cwd": ".", "steps": [["python", "-m", "unittest", "tests.{stem}"]]},
+              {"pattern": "**/tests/test_*.py", "cwd": "{parent2}",
+               "steps": [["python", "-m", "unittest", "tests.{stem}"]]}],
+    "full": [{"cwd": ".", "argv": ["python", "-m", "unittest", "discover"]}],
+    "always": [],
+}
+
+
+def load_config(root: str, path: Optional[str] = None) -> Dict:
+    p = Path(path) if path else Path(root) / ".coliagent.json"
+    if p.is_file():
+        cfg = json.loads(p.read_text(encoding="utf-8"))
+        merged = dict(DEFAULT_CONFIG)
+        merged.update(cfg)
+        return merged
+    return dict(DEFAULT_CONFIG)
+
+
+def _match(path: str, pattern: str) -> bool:
+    if fnmatch.fnmatch(path, pattern):
+        return True
+    return pattern.startswith("**/") and fnmatch.fnmatch(path, pattern[3:])
+
+
+def _fill(s: str, test: str) -> str:
+    p = PurePosixPath(test)
+    parent2 = p.parent.parent.as_posix() if len(p.parts) > 2 else "."
+    return s.replace("{stem}", p.stem).replace("{path}", test).replace("{parent2}", parent2).replace("{parent}", p.parent.as_posix())
+
+
+@dataclass
+class TestRun:
+    test: str
+    results: List[CommandResult] = field(default_factory=list)
+
+    @property
+    def ok(self) -> bool:
+        return bool(self.results) and all(r.ok for r in self.results)
+
+
+class Orchestrator:
+    def __init__(self, runner: ToolRunner, root: str, config: Optional[Dict] = None):
+        self.runner = runner
+        self.root = Path(root).resolve()
+        self.config = config if config is not None else load_config(root)
+
+    def _spec(self, test: str) -> Optional[Dict]:
+        for spec in self.config.get("tests", []):
+            if _match(test, spec["pattern"]):
+                return spec
+        return None
+
+    def is_test(self, path: str) -> bool:
+        return self._spec(path) is not None
+
+    def select_tests(self, changed: Iterable[str], index: Optional[RepoIndex] = None) -> List[str]:
+        changed = [c.replace("\\", "/") for c in changed]
+        idx = index or RepoIndex(str(self.root))
+        tests = [f for f in idx.files if self.is_test(f)]
+        chosen = {c for c in changed if c in tests}
+        dependents = idx.dependents(changed)
+        chosen.update(t for t in tests if t in dependents)
+        stems = {PurePosixPath(c).stem.lower() for c in changed if not self.is_test(c)}
+        for t in tests:
+            name = PurePosixPath(t).stem.lower()
+            if any(len(s) >= 3 and re.search(rf"(^|_){re.escape(s)}(_|$)", name) for s in stems):
+                chosen.add(t)
+        chosen.update(t for t in self.config.get("always", []) if t in tests)
+        return sorted(chosen)
+
+    def run_test(self, test: str) -> TestRun:
+        spec = self._spec(test)
+        run = TestRun(test)
+        if spec is None:
+            return run
+        cwd = self.root / _fill(spec.get("cwd", "."), test)
+        for step in spec["steps"]:
+            res = self.runner.run([_fill(a, test) for a in step], cwd=str(cwd), timeout=spec.get("timeout"))
+            run.results.append(res)
+            if not res.ok:
+                break
+        return run
+
+    def run_tests(self, tests: Iterable[str]) -> List[TestRun]:
+        return [self.run_test(t) for t in tests]
+
+    def _run_list(self, key: str) -> List[CommandResult]:
+        out = []
+        for item in self.config.get(key, []):
+            res = self.runner.run(item["argv"], cwd=str(self.root / item.get("cwd", ".")), timeout=item.get("timeout"))
+            out.append(res)
+            if not res.ok:
+                break
+        return out
+
+    def build(self) -> List[CommandResult]:
+        return self._run_list("build")
+
+    def full(self) -> List[CommandResult]:
+        return self._run_list("full")
diff --git a/agent/coliagent/patch.py b/agent/coliagent/patch.py
new file mode 100644
index 00000000..eed5ce71
--- /dev/null
+++ b/agent/coliagent/patch.py
@@ -0,0 +1,133 @@
+"""Exact, all-or-nothing multi-file edits.
+
+An edit names a file, an exact old string that must occur exactly once, and its
+replacement (an empty old string creates a new file). Every edit of a patch is
+checked against the policy and the current contents before anything is written;
+if a write fails part way, the files already written are restored.
+"""
+from __future__ import annotations
+
+import difflib
+from dataclasses import dataclass, field
+from pathlib import Path
+from typing import Dict, List, Optional
+
+from .permissions import Policy
+
+
+class PatchError(Exception):
+    pass
+
+
+@dataclass(frozen=True)
+class Edit:
+    path: str
+    old: str
+    new: str
+
+
+@dataclass
+class Patch:
+    edits: List[Edit] = field(default_factory=list)
+    description: str = ""
+
+    @property
+    def paths(self) -> List[str]:
+        seen: List[str] = []
+        for e in self.edits:
+            if e.path not in seen:
+                seen.append(e.path)
+        return seen
+
+    @classmethod
+    def from_dict(cls, d: Dict) -> "Patch":
+        edits = [Edit(str(e["path"]), str(e.get("old", "")), str(e["new"])) for e in d.get("edits", [])]
+        return cls(edits, str(d.get("description", "")))
+
+    def to_dict(self) -> Dict:
+        return {"description": self.description,
+                "edits": [{"path": e.path, "old": e.old, "new": e.new} for e in self.edits]}
+
+
+def _read(p: Path) -> Optional[str]:
+    if not p.exists():
+        return None
+    with open(p, "r", encoding="utf-8", newline="") as fh:
+        return fh.read()
+
+
+def _write(p: Path, text: str) -> None:
+    p.parent.mkdir(parents=True, exist_ok=True)
+    with open(p, "w", encoding="utf-8", newline="") as fh:
+        fh.write(text)
+
+
+def plan(patch: Patch, root: str, policy: Optional[Policy] = None) -> Dict[str, tuple]:
+    """Validate and compute {path: (before, after)} without writing anything."""
+    if not patch.edits:
+        raise PatchError("empty patch")
+    base = Path(root)
+    result: Dict[str, tuple] = {}
+    for e in patch.edits:
+        if policy is not None:
+            policy.check_write(base / e.path)
+        before, cur = result.get(e.path, (None, None))
+        if e.path not in result:
+            before = _read(base / e.path)
+            cur = before
+        if e.old == "":
+            if cur is not None:
+                raise PatchError(f"{e.path}: create edit but the file already exists")
+            cur = e.new
+        else:
+            if cur is None:
+                raise PatchError(f"{e.path}: file does not exist")
+            # match on LF so a CRLF file still matches an LF old string
+            crlf = "\r\n" in cur
+            body = cur.replace("\r\n", "\n") if crlf else cur
+            old, new = e.old.replace("\r\n", "\n"), e.new.replace("\r\n", "\n")
+            n = body.count(old)
+            if n != 1:
+                raise PatchError(f"{e.path}: old text matches {n} times (needs exactly 1)")
+            body = body.replace(old, new, 1)
+            cur = body.replace("\n", "\r\n") if crlf else body
+        result[e.path] = (before, cur)
+    return result
+
+
+def apply(patch: Patch, root: str, policy: Optional[Policy] = None) -> str:
+    """Apply atomically; return the unified diff of what changed."""
+    changes = plan(patch, root, policy)
+    base = Path(root)
+    written: List[str] = []
+    try:
+        for path, (_, after) in changes.items():
+            _write(base / path, after)
+            written.append(path)
+    except Exception:
+        for path in written:
+            before = changes[path][0]
+            if before is None:
+                (base / path).unlink(missing_ok=True)
+            else:
+                _write(base / path, before)
+        raise
+    return unified_diff(changes)
+
+
+def revert(changes: Dict[str, tuple], root: str) -> None:
+    base = Path(root)
+    for path, (before, _) in changes.items():
+        if before is None:
+            (base / path).unlink(missing_ok=True)
+        else:
+            _write(base / path, before)
+
+
+def unified_diff(changes: Dict[str, tuple]) -> str:
+    out: List[str] = []
+    for path, (before, after) in changes.items():
+        a = (before or "").splitlines(keepends=True)
+        b = (after or "").splitlines(keepends=True)
+        out.extend(difflib.unified_diff(a, b, "/dev/null" if before is None else f"a/{path}", f"b/{path}"))
+    return "".join(line if line.endswith("\n") else line + "\n" for line in out)
diff --git a/agent/coliagent/permissions.py b/agent/coliagent/permissions.py
new file mode 100644
index 00000000..2f083c5b
--- /dev/null
+++ b/agent/coliagent/permissions.py
@@ -0,0 +1,130 @@
+"""What the agent may run and write.
+
+The policy is a frozen value handed to every component that acts. Nothing in
+the agent constructs a wider policy from a narrower one, and the self-improvement
+cycle refuses any change that touches the files listed in ``protected``
+(this module among them), so the agent cannot widen its own permissions.
+"""
+from __future__ import annotations
+
+import fnmatch
+import os
+from dataclasses import dataclass, field
+from pathlib import Path
+from typing import Iterable, Sequence, Tuple
+
+
+class PermissionDenied(Exception):
+    pass
+
+
+DEFAULT_COMMANDS: Tuple[str, ...] = (
+    "git", "python", "python3", "py", "make", "cmake", "ninja", "gcc", "clang", "cc",
+    "zig", "rg", "pytest", "node", "npm", "go", "cargo",
+)
+# git subcommands that publish or rewrite shared history
+DENIED_GIT: Tuple[str, ...] = ("push", "send-email", "request-pull", "remote")
+DEFAULT_PROTECTED: Tuple[str, ...] = (
+    "agent/coliagent/permissions.py", "agent/coliagent/selfimprove.py", ".git/*", ".github/*",
+)
+SECRET_PATTERNS: Tuple[str, ...] = ("*.pem", "*.key", "*id_rsa*", "*.pfx", ".env", "*.env", "*credentials*")
+
+
+@dataclass(frozen=True)
+class Policy:
+    root: str
+    commands: Tuple[str, ...] = DEFAULT_COMMANDS
+    write_roots: Tuple[str, ...] = (".",)
+    protected: Tuple[str, ...] = DEFAULT_PROTECTED
+    allow_network: bool = False
+    max_seconds: float = 1800.0
+    max_output_bytes: int = 200_000
+    allow_repo_binaries: bool = True
+    extra_denied_git: Tuple[str, ...] = field(default_factory=tuple)
+
+    def _rel(self, path: str | os.PathLike) -> str:
+        root = Path(self.root).resolve()
+        p = Path(path)
+        p = (root / p).resolve() if not p.is_absolute() else p.resolve()
+        try:
+            return p.relative_to(root).as_posix()
+        except ValueError:
+            raise PermissionDenied(f"{path} is outside the repository {root}")
+
+    def check_write(self, path: str | os.PathLike) -> str:
+        rel = self._rel(path)
+        name = Path(rel).name
+        if any(fnmatch.fnmatch(rel, pat) for pat in self.protected):
+            raise PermissionDenied(f"{rel} is protected")
+        if any(fnmatch.fnmatch(name, pat) for pat in SECRET_PATTERNS):
+            raise PermissionDenied(f"{rel} looks like a secret")
+        roots = [_norm_root(r) for r in self.write_roots]
+        if not any(r == "" or rel == r or rel.startswith(r + "/") for r in roots):
+            raise PermissionDenied(f"{rel} is outside the write roots {self.write_roots}")
+        return rel
+
+    def check_read(self, path: str | os.PathLike) -> str:
+        rel = self._rel(path)
+        if any(fnmatch.fnmatch(Path(rel).name, pat) for pat in SECRET_PATTERNS):
+            raise PermissionDenied(f"{rel} looks like a secret")
+        return rel
+
+    def check_command(self, argv: Sequence[str]) -> None:
+        if not argv or not isinstance(argv, (list, tuple)):
+            raise PermissionDenied("a command is a non-empty argv list (no shell strings)")
+        exe = Path(argv[0]).name.lower()
+        for suffix in (".exe", ".cmd", ".bat"):
+            if exe.endswith(suffix):
+                exe = exe[: -len(suffix)]
+        if self.allow_repo_binaries and ("/" in argv[0] or "\\" in argv[0]):
+            # a binary the build produced inside the repository (a test runner);
+            # its code is under review anyway, exactly like a Python test file
+            self._rel(argv[0])
+            return
+        if exe not in self.commands:
+            raise PermissionDenied(f"{argv[0]} is not an allowed command")
+        if exe == "git":
+            sub = _git_subcommand(argv[1:])
+            if sub in DENIED_GIT + tuple(self.extra_denied_git):
+                raise PermissionDenied(f"git {sub} is not allowed: the agent never publishes")
+            if sub in ("fetch", "pull", "clone", "ls-remote") and not self.allow_network:
+                raise PermissionDenied(f"git {sub} needs the network, which the policy denies")
+        if exe in ("npm", "pip", "cargo", "go") and not self.allow_network:
+            if any(a in ("install", "add", "get", "fetch", "update") for a in argv[1:3]):
+                raise PermissionDenied(f"{exe} {argv[1]} needs the network, which the policy denies")
+        if exe in ("python", "python3", "py") and not self.allow_network:
+            if len(argv) > 3 and argv[1:3] == ["-m", "pip"] and argv[3] in ("install", "download"):
+                raise PermissionDenied("pip install needs the network, which the policy denies")
+
+    def touches_protected(self, paths: Iterable[str]) -> bool:
+        for p in paths:
+            try:
+                rel = self._rel(p)
+            except PermissionDenied:
+                return True
+            if any(fnmatch.fnmatch(rel, pat) for pat in self.protected):
+                return True
+        return False
+
+
+def _norm_root(r: str) -> str:
+    r = r.replace("\\", "/").strip("/")
+    while r.startswith("./"):
+        r = r[2:]
+    return "" if r in ("", ".") else r
+
+
+def _git_subcommand(args: Sequence[str]) -> str:
+    """The first argument that is not an option or an option's value (-c k=v, -C dir)."""
+    skip = False
+    for a in args:
+        if skip:
+            skip = False
+            continue
+        if a in ("-c", "-C", "--git-dir", "--work-tree", "--namespace"):
+            skip = True
+            continue
+        if a.startswith("-"):
+            continue
+        return a
+    return ""
diff --git a/agent/coliagent/planner.py b/agent/coliagent/planner.py
new file mode 100644
index 00000000..bfd86fb2
--- /dev/null
+++ b/agent/coliagent/planner.py
@@ -0,0 +1,134 @@
+"""Task planning with explicit dependencies.
+
+A language model may *propose* a plan (JSON); this module checks its structure
+(unique ids, known dependencies, no cycles) before anything acts on it.
+"""
+from __future__ import annotations
+
+import json
+import re
+from dataclasses import asdict, dataclass, field
+from typing import Dict, List, Optional
+
+STATUSES = ("pending", "in_progress", "done", "blocked", "failed")
+
+
+class PlanError(Exception):
+    pass
+
+
+@dataclass
+class Step:
+    id: str
+    title: str
+    detail: str = ""
+    deps: List[str] = field(default_factory=list)
+    status: str = "pending"
+    files: List[str] = field(default_factory=list)
+    verify: List[List[str]] = field(default_factory=list)  # argv lists that prove the step
+
+
+@dataclass
+class Plan:
+    goal: str
+    steps: List[Step] = field(default_factory=list)
+
+    def by_id(self) -> Dict[str, Step]:
+        return {s.id: s for s in self.steps}
+
+    def validate(self) -> None:
+        ids = [s.id for s in self.steps]
+        if len(set(ids)) != len(ids):
+            raise PlanError("duplicate step ids")
+        known = set(ids)
+        for s in self.steps:
+            if not re.fullmatch(r"[a-z0-9][a-z0-9-]*", s.id):
+                raise PlanError(f"bad step id {s.id!r} (kebab-case)")
+            if s.status not in STATUSES:
+                raise PlanError(f"{s.id}: unknown status {s.status}")
+            for d in s.deps:
+                if d not in known:
+                    raise PlanError(f"{s.id}: unknown dependency {d}")
+            for v in s.verify:
+                if not isinstance(v, list) or not v or not all(isinstance(a, str) for a in v):
+                    raise PlanError(f"{s.id}: verify entries are argv lists")
+        self.order()
+
+    def order(self) -> List[str]:
+        """Topological order; raises on a cycle."""
+        steps = self.by_id()
+        state: Dict[str, int] = {}
+        out: List[str] = []
+
+        def visit(i: str, path: List[str]) -> None:
+            if state.get(i) == 2:
+                return
+            if state.get(i) == 1:
+                raise PlanError("dependency cycle: " + " -> ".join(path + [i]))
+            state[i] = 1
+            for d in steps[i].deps:
+                visit(d, path + [i])
+            state[i] = 2
+            out.append(i)
+
+        for s in self.steps:
+            visit(s.id, [])
+        return out
+
+    def ready(self) -> List[Step]:
+        steps = self.by_id()
+        return [s for s in self.steps if s.status == "pending"
+                and all(steps[d].status == "done" for d in s.deps)]
+
+    def mark(self, step_id: str, status: str) -> None:
+        if status not in STATUSES:
+            raise PlanError(f"unknown status {status}")
+        self.by_id()[step_id].status = status
+
+    def to_json(self) -> str:
+        return json.dumps({"goal": self.goal, "steps": [asdict(s) for s in self.steps]}, indent=2)
+
+    @classmethod
+    def from_dict(cls, d: Dict) -> "Plan":
+        if not isinstance(d, dict) or "steps" not in d:
+            raise PlanError("a plan is an object with a 'steps' list")
+        steps = []
+        for raw in d["steps"]:
+            if not isinstance(raw, dict) or "id" not in raw or "title" not in raw:
+                raise PlanError("each step needs an id and a title")
+            steps.append(Step(id=str(raw["id"]), title=str(raw["title"]), detail=str(raw.get("detail", "")),
+                              deps=[str(x) for x in raw.get("deps", [])], status=str(raw.get("status", "pending")),
+                              files=[str(x) for x in raw.get("files", [])],
+                              verify=[list(map(str, v)) if isinstance(v, list) else v for v in raw.get("verify", [])]))
+        p = cls(str(d.get("goal", "")), steps)
+        p.validate()
+        return p
+
+
+PLAN_PROMPT = """You plan software changes. Reply with JSON only:
+{"goal": str, "steps": [{"id": "kebab-id", "title": str, "detail": str,
+ "deps": [ids], "files": [paths], "verify": [[argv...]]}]}
+Each step must be small, testable, and list the commands that prove it."""
+
+
+def extract_json(text: str) -> Dict:
+    """The first JSON object in a model reply (tolerates ```json fences and chatter)."""
+    m = re.search(r"```(?:json)?\s*(\{.*?\})\s*```", text, re.S)
+    candidates = [m.group(1)] if m else []
+    start = text.find("{")
+    if start >= 0:
+        candidates.append(text[start:text.rfind("}") + 1])
+    for c in candidates:
+        try:
+            return json.loads(c)
+        except json.JSONDecodeError:
+            continue
+    raise PlanError("no JSON object in the reply")
+
+
+def propose(llm, goal: str, context: str = "") -> Plan:
+    reply = llm.complete([{"role": "system", "content": PLAN_PROMPT},
+                          {"role": "user", "content": f"Goal: {goal}\n\nContext:\n{context}"}])
+    d = extract_json(reply)
+    d.setdefault("goal", goal)
+    return Plan.from_dict(d)
